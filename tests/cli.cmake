cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${OUTPUT}")
set(sentinel "${OUTPUT}/preserved.step")
file(WRITE "${sentinel}" "preserve existing output\n")
file(SHA256 "${PROJECT}" original_project)

function(accept pattern)
  execute_process(COMMAND "${DRAWER}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0" OR NOT log MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected CLI result for ${ARGN}: ${status}\n${log}\n${errors}")
  endif()
endfunction()
function(reject pattern)
  execute_process(COMMAND "${DRAWER}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(status STREQUAL "0" OR NOT errors MATCHES "${pattern}")
    message(FATAL_ERROR "Expected rejection '${pattern}' for ${ARGN}: ${status}\n${log}\n${errors}")
  endif()
endfunction()

accept("There are no built-in models" --help)
accept("carcass\tCabinet carcass and face frame\t6" --project "${PROJECT}" --list-assemblies)
accept("upper\tUpper inner drawer\t5" --project "${PROJECT}" --list-assemblies)
accept("lower\tLower pull-out tray with tall front\t6" --project "${PROJECT}" --list-assemblies)
accept("lower.face\tlower\t3.5\t0\t9.8\t470\t12\t711.2"
  --project "${PROJECT}" --describe --assembly lower --set FACE_WIDTH_MM=0 --set FACE_WIDTH_MM=470)
reject("--project FILE is required")
reject("--project FILE is required" --assembly carcass --output "${sentinel}")
reject("Missing value" --project)
reject("Missing value" --project "${PROJECT}" --set)
reject("value must not be empty" --project=)
reject("Unknown option: --model" --model carcass)
reject("Unknown option: --width" --width 300)
reject("Unknown option" --unknown 1)
reject("takes no value" --help=true)
reject("takes no value" --project "${PROJECT}" --describe=true)
reject("takes no value" --project "${PROJECT}" --list-assemblies=true)
reject("takes no value" --project "${PROJECT}" --all=true)
reject("cannot be combined" --project "${PROJECT}" --list-assemblies --assembly carcass)
reject("cannot be combined" --project "${PROJECT}" --list-assemblies --describe)
reject("cannot be combined" --project "${PROJECT}" --list-assemblies --output "${sentinel}")
reject("cannot be combined" --project "${PROJECT}" --all --assembly carcass --output-dir "${OUTPUT}")
reject("cannot be combined" --project "${PROJECT}" --all --list-outputs --output-dir "${OUTPUT}")
reject("cannot be combined" --project "${PROJECT}" --all --output "${sentinel}")
reject("cannot be combined" --project "${PROJECT}" --assembly carcass --output "${sentinel}" --output-dir "${OUTPUT}")
reject("--output-dir DIR is required" --project "${PROJECT}" --all)
reject("--output-dir DIR is required" --project "${PROJECT}" --list-outputs)
accept("cabinet-carcass.step\n.*inner-drawer-477x523x102.step\n.*tall-front-bottom-aligned.step"
  --project "${PROJECT}" --list-outputs --output-dir "${OUTPUT}")
reject("does not accept --output" --project "${PROJECT}" --describe --output "${sentinel}")
reject("requires --assembly" --project "${PROJECT}" --output "${sentinel}")
reject("requires --assembly" --project "${PROJECT}" --assembly carcass)
reject("Unknown assembly" --project "${PROJECT}" --assembly missing --output "${sentinel}")
reject("must not overwrite" --project "${PROJECT}" --assembly carcass --output "${PROJECT}")
set(linked_project "${OUTPUT}/project-hardlink.json")
file(REMOVE "${linked_project}")
file(CREATE_LINK "${PROJECT}" "${linked_project}" RESULT link_result)
if(link_result STREQUAL "0")
  reject("must not overwrite" --project "${PROJECT}" --assembly carcass --output "${linked_project}")
  file(SHA256 "${linked_project}" linked_hash)
  if(NOT linked_hash STREQUAL original_project)
    message(FATAL_ERROR "Project content changed through a hard-linked output")
  endif()
else()
  message(STATUS "Hard-link overwrite regression unavailable: ${link_result}")
endif()
set(published "${OUTPUT}/published.step")
set(stale_slot "${published}.writing.0")
file(REMOVE_RECURSE "${published}" "${stale_slot}")
file(MAKE_DIRECTORY "${stale_slot}")
file(WRITE "${stale_slot}/keep.txt" "stale export belongs to another run\n")
accept("Saved and verified" --project "${PROJECT}" --assembly carcass --output "${published}")
if(NOT EXISTS "${published}" OR NOT EXISTS "${stale_slot}/keep.txt" OR EXISTS "${published}.writing.1")
  message(FATAL_ERROR "Export did not preserve a pre-existing temporary slot")
endif()
set(blocked "${OUTPUT}/blocked.step")
file(REMOVE_RECURSE "${blocked}")
file(MAKE_DIRECTORY "${blocked}")
file(WRITE "${blocked}/keep.txt" "preserve destination\n")
execute_process(COMMAND "${DRAWER}" --project "${PROJECT}" --assembly carcass --output "${blocked}"
  RESULT_VARIABLE blocked_status OUTPUT_VARIABLE blocked_log ERROR_VARIABLE blocked_error)
file(GLOB blocked_slots "${blocked}.writing.*")
file(READ "${blocked}/keep.txt" blocked_contents)
if(blocked_status STREQUAL "0" OR NOT blocked_error MATCHES "filesystem error"
   OR NOT blocked_contents STREQUAL "preserve destination\n" OR blocked_slots)
  message(FATAL_ERROR "Failed publication damaged its destination or left temporary output: ${blocked_status}\n${blocked_log}\n${blocked_error}")
endif()
reject("Cannot read project" --project "${OUTPUT}/missing.json" --list-assemblies)
foreach(value WIDTH WIDTH= =1)
  reject("--set expects" --project "${PROJECT}" --set "${value}" --describe)
endforeach()
reject("Unknown parameter override" --project "${PROJECT}" --set TYPO=1 --describe)
reject("Circular relationship" --project "${PROJECT}" --set FACE_TOP_Z_MM=lower.face.top_z --describe)
foreach(value 0 -1)
  reject("dimensions must be" --project "${PROJECT}" --set "FACE_WIDTH_MM=${value}" --describe)
endforeach()
foreach(value nan inf 12mm)
  reject("Unknown reference|Unexpected" --project "${PROJECT}" --set "FACE_WIDTH_MM=${value}" --describe)
endforeach()

file(READ "${sentinel}" contents)
file(SHA256 "${PROJECT}" final_project)
if(NOT contents STREQUAL "preserve existing output\n" OR NOT original_project STREQUAL final_project)
  message(FATAL_ERROR "Rejected commands modified an existing output or the source project")
endif()
message(STATUS "Configuration-only CLI, discovery, overrides, diagnostics and output preservation verified")
