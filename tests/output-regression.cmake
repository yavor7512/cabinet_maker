cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${OUTPUT}")
string(RANDOM LENGTH 12 nonce)
set(work "${OUTPUT}/${nonce}")
set(fixtures "${ROOT}/tests/fixtures/pre-config")
file(MAKE_DIRECTORY "${work}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  file(APPEND "${work}/regression.log" "${log}\n${errors}\n")
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Output regression failed (${status}): ${ARGV}\n${errors}\n${log}")
  endif()
endfunction()
set(INPUT "${ROOT}/designs/cabinet.jsonnet")
set(OUTPUT "${work}/cabinet.json")
include("${ROOT}/cmake/ExpandProject.cmake")
set(upper inner-drawer-477x523x102.step)
set(lower tall-front-bottom-aligned.step)
set(carcass cabinet-carcass.step)
foreach(assembly upper lower carcass)
  run("${DRAWER}" --project "${OUTPUT}" --assembly "${assembly}" --output "${work}/${${assembly}}")
  run("${COMPARE}" --compare "${fixtures}/${${assembly}}" "${work}/${${assembly}}")
endforeach()
message(STATUS "PASS: all 33 parts match the original pre-configuration models, including machining, positions and names")
foreach(export complete-cabinet complete-cabinet-autocad)
  set(options)
  if(export STREQUAL "complete-cabinet-autocad")
    set(options --autocad)
  endif()
  run("${MERGE}" ${options} --color "#A8793E" --output "${work}/${export}.step"
    "${work}/${carcass}" "${work}/${upper}" "${work}/${lower}")
  run("${COMPARE}" --compare "${fixtures}/${export}.step" "${work}/${export}.step")
endforeach()
message(STATUS "PASS: both merged exports match in hierarchy, part order, color, orientation and occupied material")
run("${CUTLIST}" --out "${work}/packet" --sheets 5x5 --kerf 5 --workflow shop
  --extra-area-percent 35 --shop-attempts 64 --export-details "${work}/complete-cabinet.step")
file(SHA256 "${fixtures}/shop-packet.pdf" expected)
file(SHA256 "${work}/packet/shop-packet.pdf" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Shop packet changed: expected SHA256 ${expected}, got ${actual}. Inspect ${work}/packet.")
endif()
message(STATUS "PASS: shop packet is byte-for-byte identical to the original pre-configuration PDF (${actual})")
message(STATUS "Regression artifacts and cut-plan details: ${work}")
