cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${OUTPUT}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Template test failed (${status}): ${errors}\n${log}")
  endif()
  set(last_output "${log}" PARENT_SCOPE)
endfunction()
foreach(case repeated alternate-joinery)
  run("${JSONNET_EXECUTABLE}" --tla-str "case=${case}" "${ROOT}/tests/template-cases.jsonnet" -o "${OUTPUT}/${case}.json")
endforeach()
run("${JSONNET_EXECUTABLE}" "${ROOT}/tests/standalone.jsonnet" -o "${OUTPUT}/standalone.json")
run("${DRAWER}" --project "${OUTPUT}/standalone.json" --list-assemblies)
if(NOT last_output MATCHES "shelf\tÉtagère shelf\t1\tdisplay shelf.step")
  message(FATAL_ERROR "Standalone assembly was not discovered: ${last_output}")
endif()
run("${DRAWER}" --project "${OUTPUT}/standalone.json" --all --output-dir "${OUTPUT}/standalone")
if(NOT EXISTS "${OUTPUT}/standalone/display shelf.step")
  message(FATAL_ERROR "Standalone configured filename was not used")
endif()
run("${DRAWER}" --project "${OUTPUT}/repeated.json" --describe)
if(NOT last_output MATCHES "sample2.left\tsample2\t0\t12\t400\t12\t523\t142")
  message(FATAL_ERROR "Third independent drawer instance did not resolve correctly: ${last_output}")
endif()
run("${DRAWER}" --project "${OUTPUT}/repeated.json" --assembly sample2 --output "${OUTPUT}/third-drawer.step")
run("${DRAWER}" --project "${OUTPUT}/alternate-joinery.json" --describe)
if(NOT last_output MATCHES "sample.top\tsample\t-18\t18\t737\t530\t579\t18")
  message(FATAL_ERROR "External construction change did not widen cap: ${last_output}")
endif()
run("${DRAWER}" --project "${OUTPUT}/alternate-joinery.json" --assembly sample --output "${OUTPUT}/changed-joinery.step")
foreach(case typo duplicate)
  execute_process(COMMAND "${JSONNET_EXECUTABLE}" --tla-str "case=${case}" "${ROOT}/tests/template-cases.jsonnet"
    RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_QUIET)
  if(status STREQUAL "0")
    message(FATAL_ERROR "Invalid ${case} configuration was accepted")
  endif()
  if(case STREQUAL "typo" AND NOT errors MATCHES "Unknown configuration field.*widht")
    message(FATAL_ERROR "Unexpected typo diagnostic: ${errors}")
  elseif(case STREQUAL "duplicate" AND NOT errors MATCHES "Duplicate name")
    message(FATAL_ERROR "Unexpected duplicate diagnostic: ${errors}")
  endif()
endforeach()
message(STATUS "Reusable instances, external construction changes, unknown fields and duplicate names verified")
