# Only remove this tool's generated test fixture output, inside its build tree.
file(REMOVE_RECURSE "${OUTPUT}")
execute_process(COMMAND "${TOOL}" --out "${OUTPUT}" "${INPUT}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cut-list integration failed: ${status}")
endif()
file(GLOB outputs "${OUTPUT}/*")
list(LENGTH outputs count)
if(NOT count EQUAL 1 OR NOT EXISTS "${OUTPUT}/shop-packet.pdf")
  message(FATAL_ERROR "Default output must be exactly one PDF")
endif()
file(READ "${OUTPUT}/shop-packet.pdf" signature LIMIT 8)
if(NOT signature MATCHES "%PDF-1.4")
  message(FATAL_ERROR "Invalid PDF header")
endif()
file(REMOVE_RECURSE "${OUTPUT}-details")
execute_process(COMMAND "${TOOL}" --workflow material --export-details --out "${OUTPUT}-details" "${INPUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${OUTPUT}-details/details/inventory.csv" OR NOT EXISTS "${OUTPUT}-details/shop-packet.pdf")
  message(FATAL_ERROR "Detailed material export failed")
endif()
file(READ "${OUTPUT}/shop-packet.pdf" pdf)
if(pdf MATCHES "Blank identification labels")
  message(FATAL_ERROR "Default packet must not include identification-label pages")
endif()
if(NOT pdf MATCHES "/FontName /HelveticaNeue" OR NOT pdf MATCHES "/FontFile2")
  message(FATAL_ERROR "Helvetica Neue must be embedded")
endif()

file(STRINGS "${OUTPUT}/shop-packet.pdf" packet_text REGEX "KEEP LEFT|C4R|5 mm")
if(NOT packet_text MATCHES "KEEP LEFT" OR NOT packet_text MATCHES "C4R" OR NOT packet_text MATCHES "5 mm")
  message(FATAL_ERROR "Packet must explain left-side references and default 5 mm allowance")
endif()
file(GLOB cut_tables "${OUTPUT}-details/details/thickness-*/cuts.csv")
foreach(table IN LISTS cut_tables)
  file(READ "${table}" cut_csv)
  if(NOT cut_csv MATCHES "from_panel,keep_left_mm,left_piece,right_remainder,orientation")
    message(FATAL_ERROR "Detailed cuts must include subpanel references and kept-edge dimensions")
  endif()
endforeach()
