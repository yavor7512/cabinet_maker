cmake_minimum_required(VERSION 3.20)
foreach(var INPUT OUTPUT)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "${var} must name a project file")
  endif()
endforeach()
get_filename_component(input_path "${INPUT}" ABSOLUTE)
get_filename_component(output_path "${OUTPUT}" ABSOLUTE)
if(EXISTS "${INPUT}")
  file(REAL_PATH "${INPUT}" input_path)
endif()
if(EXISTS "${OUTPUT}")
  file(REAL_PATH "${OUTPUT}" output_path)
endif()
if(input_path STREQUAL output_path)
  message(FATAL_ERROR "Expanded output must not overwrite its source project")
endif()
get_filename_component(extension "${INPUT}" LAST_EXT)
if(NOT extension STREQUAL ".jsonnet" AND NOT extension STREQUAL ".json")
  message(FATAL_ERROR "PROJECT_FILE must end in .jsonnet or .json: ${INPUT}")
endif()
if(NOT EXISTS "${INPUT}" OR IS_DIRECTORY "${INPUT}")
  message(FATAL_ERROR "Cannot read project: ${INPUT}")
endif()
get_filename_component(parent "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
string(RANDOM LENGTH 16 nonce)
set(temporary "${OUTPUT}.${nonce}.tmp")
if(extension STREQUAL ".jsonnet")
  if(NOT DEFINED JSONNET_EXECUTABLE)
    find_program(JSONNET_EXECUTABLE NAMES jsonnet)
  endif()
  if(NOT JSONNET_EXECUTABLE)
    message(FATAL_ERROR "Jsonnet is required. Install it with 'brew install jsonnet', or set JSONNET to its executable path in Make.")
  endif()
  execute_process(COMMAND "${JSONNET_EXECUTABLE}" -o "${temporary}" "${INPUT}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0")
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Jsonnet expansion failed (${status}):\n${errors}")
  endif()
else()
  configure_file("${INPUT}" "${temporary}" COPYONLY)
endif()
# A failed expansion never replaces the last valid configuration.
file(RENAME "${temporary}" "${OUTPUT}")
