cmake_minimum_required(VERSION 3.20)

# Only remove verified build trees belonging to this project. Validate every
# candidate first, so a bad override cannot cause a partially completed clean.
foreach(var PROJECT_ROOT OUTPUT_DIR DRAWER_BUILD MERGE_BUILD CUTLIST_BUILD)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "${var} must not be empty")
  endif()
endforeach()
file(REAL_PATH "${PROJECT_ROOT}" root)
file(REAL_PATH "${OUTPUT_DIR}" output BASE_DIRECTORY "${root}")

function(validate_build path source project)
  get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${root}")
  if(IS_SYMLINK "${absolute}")
    message(FATAL_ERROR "Refusing to clean a symlink: ${absolute}")
  endif()
  file(REAL_PATH "${absolute}" candidate)
  foreach(protected "${root}" "${root}/tools/step-merge" "${root}/tools/step-cutlist" "${output}")
    cmake_path(IS_PREFIX candidate "${protected}" NORMALIZE contains_protected)
    if(contains_protected)
      message(FATAL_ERROR "Refusing to clean a source/output directory or its parent: ${candidate}")
    endif()
  endforeach()
  if(NOT EXISTS "${candidate}")
    return()
  endif()
  if(NOT IS_DIRECTORY "${candidate}" OR NOT EXISTS "${candidate}/CMakeCache.txt")
    message(FATAL_ERROR "Refusing to clean an unrecognized build directory: ${candidate}")
  endif()
  file(STRINGS "${candidate}/CMakeCache.txt" home_line REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
  file(STRINGS "${candidate}/CMakeCache.txt" project_line REGEX "^CMAKE_PROJECT_NAME:STATIC=")
  string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" home "${home_line}")
  file(REAL_PATH "${home}" home)
  file(REAL_PATH "${source}" expected)
  if(NOT home STREQUAL expected OR NOT project_line STREQUAL "CMAKE_PROJECT_NAME:STATIC=${project}")
    message(FATAL_ERROR "Refusing to clean a build tree for another project: ${candidate}")
  endif()
  set(to_remove ${to_remove} "${candidate}" PARENT_SCOPE)
endfunction()

validate_build("${DRAWER_BUILD}" "${root}" EddieDrawer)
validate_build("${MERGE_BUILD}" "${root}/tools/step-merge" StepMerge)
validate_build("${CUTLIST_BUILD}" "${root}/tools/step-cutlist" StepCutlist)
foreach(path IN LISTS to_remove)
  message(STATUS "Removing build tree: ${path}")
  file(REMOVE_RECURSE "${path}")
  if(EXISTS "${path}")
    message(FATAL_ERROR "Could not remove build tree: ${path}")
  endif()
endforeach()
message(STATUS "Clean complete; generated models, PDFs and archives preserved")
